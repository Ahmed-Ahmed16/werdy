reminders-title = التذكيرات
reminders-help = تذكير هادئ بما بقي من أعمالك. قد يتأخر بضع دقائق.
reminders-location = احفظ موقعك لتعمل تذكيرات الصلاة.
reminders-allow = السماح بالإشعارات
reminders-permission-help = فعّل الإشعارات من إعدادات الهاتف إذا بقيت متوقفة.
reminders-delay = بعد الصلاة
reminders-delay-minutes =
    { $minutes ->
        [zero] دون تأخير
        [one] دقيقة واحدة
        [two] دقيقتان
        [few] { $minutes } دقائق
       *[other] { $minutes } دقيقة
    }
reminders-time = وقت التذكير
reminders-deed = تذكير بهذا العمل
reminders-notification-title = تذكير: { $name }
reminders-notification-body = بقي لك: { $deeds }
reminders-list-separator = { "، " }
reminders-more =
    { $count ->
        [one] وعمل آخر
        [two] وعملان آخران
        [few] و{ $count } أعمال أخرى
       *[other] و{ $count } عمل آخر
    }
reminders-push-privacy = يتلقى خادم werdy أوقات التذكير فقط. قد تشير إلى مدينتك، لا إلى عنوانك.
reminders-push-unavailable = التذكيرات غير متاحة بعد.
reminders-push-iphone = أضف werdy إلى الشاشة الرئيسية لتصلك التذكيرات.
reminders-push-unsupported = لا يستطيع هذا المتصفح عرض التذكيرات.
reminders-push-blocked = الإشعارات محظورة. اسمح بها من إعدادات المتصفح.
reminders-push-signed-out = سجّل الدخول لاستخدام التذكيرات.
reminders-push-switch = التذكيرات على هذا الجهاز
reminders-push-title = werdy
reminders-push-body = أعمال { $prayer } تنتظرك.
reminders-push-last = أعمال { $prayer } تنتظرك. افتح werdy لتستمر التذكيرات.


