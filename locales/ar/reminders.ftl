reminders-title = التذكيرات
reminders-help = تذكير هادئ بما بقي من أعمالك. قد يتأخر بضع دقائق.
reminders-location = احفظ موقعك لتعمل تذكيرات الصلاة.
reminders-allow = السماح بالإشعارات
reminders-permission-help = فعّل الإشعارات من إعدادات الهاتف إذا بقيت متوقفة.
reminders-delay = بعد الصلاة
reminders-delay-minutes =
    { $minutes ->
        [zero] دون تأخير
        [one] دقيقة واحدة
        [two] دقيقتان
        [few] { $minutes } دقائق
       *[other] { $minutes } دقيقة
    }
reminders-time = وقت التذكير
reminders-deed = تذكير بهذا العمل
reminders-notification-title = تذكير: { $name }
reminders-notification-body = بقي لك: { $deeds }
reminders-list-separator = { "، " }
reminders-more =
    { $count ->
        [one] وعمل آخر
        [two] وعملان آخران
        [few] و{ $count } أعمال أخرى
       *[other] و{ $count } عمل آخر
    }


